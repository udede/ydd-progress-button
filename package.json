{
  "name": "ydd-progress-button",
  "version": "1.2.3",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run build:lib && npm run build:showcase",
    "copy:readme": "copyfiles ./README.md ./projects/progress-button && copyfiles ./README.md ./projects/progress-button-showcase",
    "copy:changelog": "copyfiles ./CHANGELOG.md ./projects/progress-button",
    "build:lib": "npm run copy:readme && npm run copy:changelog && ng build progress-button",
    "build:showcase": "ng build progress-button-showcase --base-href='.'",
    "publish:showcase": "npx ngh --dir=dist/progress-button-showcase",
    "test": "ng test",
    "test-headless": "ng test --code-coverage --watch=false --browsers=ChromeHeadless",
    "version": "standard-version"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~21.0.0",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "~21.0.0",
    "@angular/compiler": "~21.0.0",
    "@angular/core": "~21.0.0",
    "@angular/forms": "~21.0.0",
    "@angular/platform-browser": "~21.0.0",
    "@angular/platform-browser-dynamic": "~21.0.0",
    "@angular/router": "~21.0.0",
    "@ng-select/ng-select": "^14.0.0",
    "angular-cli-ghpages": "^2.0.0",
    "ngx-markdown": "^19.0.0",
    "ngx-scrollbar": "^15.0.0",
    "prismjs": "^1.29.0",
    "rxjs": "~7.8.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~21.0.0",
    "@angular/cli": "~21.0.0",
    "@angular/compiler-cli": "~21.0.0",
    "@angular/language-service": "~21.0.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.0.0",
    "copyfiles": "^2.4.1",
    "jasmine-core": "~5.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "~21.0.0",
    "standard-version": "^9.5.0",
    "ts-node": "~10.9.0",
    "typescript": "~5.9.0"
  }
}
